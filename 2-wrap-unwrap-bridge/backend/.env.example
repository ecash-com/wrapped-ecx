# --- Required secrets ---
# ECX treasury: BIP39 mnemonic dedicated to this service (don't reuse one that controls funds elsewhere).
WALLET_MNEMONIC="lucky behind faith leader kitten undo lake comfort gospel oven magic cigar" # Empty example seed
# Solana treasury: base58-encoded 64-byte secret key (`cargo run -- solana-keygen` prints one).
# Separate from WALLET_MNEMONIC - different curve (ed25519 vs secp256k1), kept separate to
# limit blast radius if one key leaks.
SOLANA_KEYPAIR="vzXkV1Z3JK6EzPoDJpXPm3bss7HBh26mCojHZwd34gJnZag4AUjjeaT8T7NmABVtFY1j9GvwpUg3xivQpi5Mkqf" # Empty example seed

# --- Other required envs ---
WECX_MINT_ADDRESS="EVHqNdzjCupKi4rQkbuYw52sa1m8A7jeUAMP23S9AVVq"

# URLs
ECX_ESPLORA_URL="https://explorer.beta.ecash.ninja/api/"
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"






# --- Optional (everything below is commented out; defaults shown) ---
# SQLite database file (created if missing).
# DATABASE_PATH="data/bridge.db"
# WALLET_PASSPHRASE=""
# ECX_BACKEND="esplora"
# ESPLORA_TIMEOUT_SECS="20"

# ORDER_POLL_INTERVAL_MINUTES="5"
# ORDER_MAX_AGE_HOURS="24"

# MIN_DEPOSIT_AMOUNT_SAT="500"
# ECX_DEPOSIT_MIN_CONFS="1"
# ECX_PAYOUT_FEE_RATE_SAT_VB="2"

# Flat bps fee (100 = 1%) on each bridge direction: PEGIN_FEE_BPS for ECX->wECX,
# PEGOUT_FEE_BPS for wECX->ECX. Both are placeholder defaults, not a reviewed fee policy.
# The team's working target was 20 bps peg-in / 100 bps peg-out - not applied here yet.
# PEGIN_FEE_BPS="100"
# PEGOUT_FEE_BPS="100"

# Both betanet ECX and Solana mainnet-beta are real money (see CLAUDE.md) - gates every automatic
# outbound send in both directions (wECX payouts, ECX refunds, ECX payouts, wECX refunds) the
# background poller makes. Set to 1 only once you've verified the bridge end to end.
# ALLOW_LIVE_PAYOUTS=0

# --- Abuse limits / safety floors (all optional; defaults shown) ---
# Largest single order, in sat (default: 21M ECX, i.e. effectively unbounded - lower it to cap exposure).
# MAX_DEPOSIT_AMOUNT_SAT="2100000000000000"
# Global caps on the unauthenticated endpoints. Per-IP limits belong at the reverse proxy.
# ORDERS_PER_MINUTE="30"
# MAX_PENDING_ORDERS="200"
# Min spacing between explorer syncs triggered by GET /orders/{id} (each holds the wallet lock).
# GET_SYNC_MIN_INTERVAL_SECS="10"
# Below this treasury SOL balance (lamports; 0.02 SOL) new orders are refused and payouts held.
# Each payout to a new recipient spends ~0.002 SOL of ATA rent, so keep the treasury topped up and
# set MIN_DEPOSIT_AMOUNT_SAT high enough that a minimum deposit is worth that rent to you.
# TREASURY_MIN_SOL_LAMPORTS="20000000"
# Off-curve (PDA) Solana recipients, e.g. some multisig vaults, are refused unless this is 1.
# ALLOW_OFF_CURVE_RECIPIENTS="0"
